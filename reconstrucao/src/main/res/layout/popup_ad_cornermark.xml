<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical"
    android:layout_width="336.0dip"
    android:layout_height="180.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
