<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal"
    android:background="@drawable/kidsmode_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/menu_child_bg"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent">

        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="40.0dip"
            android:paddingTop="68.0dip"
            android:paddingRight="40.0dip"
            android:layout_width="@dimen/kids_width"
            android:layout_height="fill_parent">

            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/kidsmode_create_iv"
                    android:visibility="gone"
                    android:layout_width="80.0dip"
                    android:layout_height="80.0dip"
                    android:src="@drawable/icon_about"
                    android:scaleType="fitXY" />

                <TextView
                    android:textSize="22.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/kidsmode_title"
                    android:id="@+id/kidsmode_create_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:text="@string/kidsmode_create" />
            </LinearLayout>

            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/kidsmode_welcome"
                android:id="@+id/kidsmode_step1_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="6.0dip"
                android:text="@string/kidsmode_step1" />

            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/kidsmode_step"
                android:id="@+id/kidsmode_step2_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="24.0dip"
                android:text="@string/kidsmode_step2" />

            <com.live.tvcinema.widget.PasswordInputView
                android:id="@+id/kidsmode_pwd_et"
                android:nextFocusLeft="@id/kidsmode_pwd_et"
                android:nextFocusRight="@id/kidsmode_pwd_et"
                android:nextFocusDown="@id/kidsmode_submit_btn"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="24.0dip"
                style="@style/PasswordStyle" />

            <TextView
                android:textSize="16.0sp"
                android:textColor="@color/kidsmode_btn_text"
                android:gravity="center"
                android:id="@+id/kidsmode_submit_btn"
                android:background="@drawable/kidsmode_btn_selector"
                android:focusable="true"
                android:nextFocusLeft="@id/kidsmode_submit_btn"
                android:nextFocusRight="@id/kidsmode_submit_btn"
                android:nextFocusUp="@id/kidsmode_pwd_et"
                android:nextFocusDown="@id/kidsmode_submit_btn"
                android:clickable="true"
                android:layout_width="@dimen/kids_btn_width"
                android:layout_height="@dimen/kids_btn_height"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="48.0dip"
                android:text="@string/adult_submit" />

            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/kidsmode_step"
                android:id="@+id/kidsmode_step3_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip"
                android:text="@string/kidsmode_step3" />

            <TextView
                android:textSize="18.0sp"
                android:textColor="@color/kidsmode_btn_text"
                android:gravity="center"
                android:id="@+id/kidsmode_enter_btn"
                android:background="@drawable/kidsmode_btn_selector"
                android:visibility="gone"
                android:nextFocusUp="@id/kidsmode_submit_btn"
                android:nextFocusDown="@id/kidsmode_enter_btn"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/et_height"
                android:layout_marginTop="12.0dip"
                android:text="@string/kidsmode_enter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kidsmode_arrow_layout"
            android:visibility="gone"
            android:layout_width="@dimen/arrow_width"
            android:layout_height="fill_parent">

            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/kidsmode_arrow_iv"
                android:paddingLeft="2.0dip"
                android:focusable="false"
                android:layout_width="@dimen/arrow_width"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_right_white_icon" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <FrameLayout
            android:id="@+id/kidsmode_program_fl"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

        <FrameLayout
            android:id="@+id/kidsmode_bg_fl"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
</LinearLayout>