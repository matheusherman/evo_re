<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/kidsmode_pwdforget_fragment"
    android:background="@drawable/kidsmode_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/kidsmode_pwdforget_layout"
        android:background="@drawable/kidsmode_dialog_bg"
        android:paddingLeft="40.0dip"
        android:paddingTop="48.0dip"
        android:paddingRight="40.0dip"
        android:layout_width="@dimen/kids_dialog_width"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/kids_dialog_height">

        <TextView
            android:textSize="22.0sp"
            android:textStyle="bold"
            android:textColor="@color/kidsmode_title"
            android:id="@+id/kidsmode_pwd_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:text="@string/kidsmode_pwd_title" />

        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/kidsmode_step"
            android:id="@+id/kidsmode_pwd_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="30.0dip"
            android:text="@string/kidsmode_pwdpre_enter" />

        <com.live.tvcinema.widget.PasswordInputView
            android:id="@+id/kidsmode_pwd_et"
            android:nextFocusLeft="@id/kidsmode_pwd_et"
            android:nextFocusRight="@id/kidsmode_pwd_et"
            android:nextFocusUp="@id/kidsmode_pwd_et"
            android:nextFocusDown="@id/kidsmode_newpwd_et"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            style="@style/PasswordStyle" />

        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/kidsmode_step"
            android:id="@+id/kidsmode_newpwd_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="0.0dip"
            android:text="@string/kidsmode_pwdnew_enter" />

        <com.live.tvcinema.widget.PasswordInputView
            android:id="@+id/kidsmode_newpwd_et"
            android:nextFocusLeft="@id/kidsmode_newpwd_et"
            android:nextFocusRight="@id/kidsmode_newpwd_et"
            android:nextFocusUp="@id/kidsmode_pwd_et"
            android:nextFocusDown="@id/kidsmode_submit_btn"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            style="@style/PasswordStyle" />

        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/kidsmode_btn_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="20.0dip">

            <Button
                android:textSize="16.0sp"
                android:textColor="@color/kidsmode_btn_text"
                android:gravity="center"
                android:id="@+id/kidsmode_submit_btn"
                android:background="@drawable/kidsmode_btn_selector"
                android:nextFocusLeft="@id/kidsmode_cancel_btn"
                android:nextFocusRight="@id/kidsmode_submit_btn"
                android:nextFocusUp="@id/kidsmode_newpwd_et"
                android:nextFocusDown="@id/kidsmode_submit_btn"
                android:layout_width="@dimen/kids_btn_width2"
                android:layout_height="@dimen/kids_btn_height"
                android:text="@string/submit"
                android:textAllCaps="false" />

            <Button
                android:textSize="16.0sp"
                android:textColor="@color/kidsmode_btn_text"
                android:gravity="center"
                android:id="@+id/kidsmode_cancel_btn"
                android:background="@drawable/kidsmode_btn_selector"
                android:nextFocusLeft="@id/kidsmode_cancel_btn"
                android:nextFocusRight="@id/kidsmode_submit_btn"
                android:nextFocusUp="@id/kidsmode_newpwd_et"
                android:nextFocusDown="@id/kidsmode_cancel_btn"
                android:layout_width="@dimen/kids_btn_width2"
                android:layout_height="@dimen/kids_btn_height"
                android:layout_marginLeft="12.0dip"
                android:text="@string/cancel"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/kidsmode_tip"
            android:id="@+id/kidsmode_tip_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="15.0dip"
            android:text="@string/kidsmode_pwdforget_enter" />

        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="8.0dip">

            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/kidsmode_email_icon" />

            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/kidsmode_tip"
                android:gravity="center_vertical"
                android:id="@+id/kidsmode_email_tv"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="-2.0dip" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="5.0dip">

            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/kidsmode_phone_icon" />

            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/kidsmode_tip"
                android:gravity="center_vertical"
                android:id="@+id/kidsmode_phone_tv"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="-2.0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>