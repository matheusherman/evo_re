<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    android:id="@+id/remindl_rl_parent"
    android:background="@drawable/expired_dialog_bg"
    android:padding="40.0dip"
    android:layout_width="@dimen/recharge_dialog_width"
    android:layout_height="@dimen/recharge_dialog_height"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:textSize="@dimen/remind_text_size"
        android:textColor="@color/remindl_tv_userid_tc"
        android:id="@+id/remindl_tv_userid"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <TextView
        android:id="@+id/remindl_tv_expired"
        android:layout_marginTop="30.0dip"
        android:layout_below="@id/remindl_tv_userid"
        android:layout_centerInParent="true"
        style="@style/ExpiredStyle" />

    <LinearLayout
        android:gravity="center"
        android:id="@+id/remindl_ll_recharge"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_below="@id/remindl_tv_expired">

        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/remindl_tv_now_tc"
            android:gravity="center"
            android:id="@+id/remindl_tv_now"
            android:background="@drawable/dialog_btn_bg_selector"
            android:focusable="true"
            android:layout_width="220.0dip"
            android:layout_height="fill_parent"
            android:text="@string/recharge_now" />

        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/remindl_tv_exit_tc"
            android:gravity="center"
            android:id="@+id/remindl_tv_exit"
            android:background="@drawable/dialog_btn_bg_selector"
            android:focusable="true"
            android:layout_width="220.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="30.0dip"
            android:text="@string/exit" />
    </LinearLayout>

    <TextView
        android:textSize="@dimen/remind_text_size"
        android:textColor="@color/remindl_tv_how_to_recharge_tc"
        android:id="@+id/remindl_tv_how_to_recharge"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_below="@id/remindl_ll_recharge"
        android:layout_centerHorizontal="true" />

    <TextView
        android:textSize="18.0sp"
        android:id="@+id/remindl_tv_remind_bottom"
        android:padding="10.0dip"
        android:visibility="gone"
        android:layout_below="@id/remindl_tv_how_to_recharge"
        style="@style/ExpiredStyle" />
</RelativeLayout>