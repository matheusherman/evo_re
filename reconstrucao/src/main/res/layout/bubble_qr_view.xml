<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.live.tvcinema.widget.BubbleView
        android:id="@+id/bubble_qr_view"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:arrowDirection="1"
        app:bubbleBackColor="@color/color_focused"
        app:bubblePaintX="300.0dip"
        app:bubbleWidth="400.0dip" />

    <TextView
        android:textSize="15.0sp"
        android:textColor="@color/text_color_epg_normal"
        android:gravity="center"
        android:id="@+id/bubble_qr_text"
        android:layout_width="fill_parent"
        android:layout_height="130.0dip"
        android:text="@string/bubble_qr_tip"
        android:lineSpacingExtra="5.0dip" />
</RelativeLayout>