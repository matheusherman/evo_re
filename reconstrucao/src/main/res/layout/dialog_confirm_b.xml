<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/confirmdlg_ll_parent"
    android:layout_width="570.0dip"
    android:layout_height="wrap_content"
    android:background="#ff262626"
    android:minHeight="161.0dip"
    android:paddingStart="20.0dip"
    android:paddingTop="40.0dip"
    android:paddingRight="20.0dip"
    android:paddingBottom="40.0dip">

    <TextView
        android:id="@+id/confirmdlg_tv_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        android:textColor="#ffcccccc"
        android:textSize="19.0sp" />

    <LinearLayout
        android:id="@+id/confirmdlg_ll_btn_cont"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/confirmdlg_tv_msg"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="23.0dip"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <View
            android:id="@+id/confirmdlg_view_btn_left"
            android:layout_width="80.0dip"
            android:layout_height="60.0dip"
            android:layout_marginLeft="@dimen/normal_btn_padding"
            android:visibility="gone" />

        <Button
            android:id="@+id/confirmdlg_btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/confirm_btn_h"
            android:background="@drawable/bg_confirm_btn"
            android:minWidth="@dimen/confirm_btn_w"
            android:text="@string/ok"
            android:textAllCaps="false"
            android:textColor="@color/confirm_btn_text"
            android:textSize="@dimen/confirm_btn_text_size" />

        <Button
            android:id="@+id/confirmdlg_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/confirm_btn_h"
            android:layout_marginStart="20.0dip"
            android:background="@drawable/bg_confirm_btn"
            android:minWidth="@dimen/confirm_btn_w"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/confirm_btn_text"
            android:textSize="@dimen/confirm_btn_text_size" />
    </LinearLayout>
</RelativeLayout>