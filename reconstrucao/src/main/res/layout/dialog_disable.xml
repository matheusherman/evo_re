<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/confirmdlg_ll_parent"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@color/disable_bg_color"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <TextView
            android:textSize="30.0sp"
            android:textColor="@color/color_eeeeee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/appdisable_tv_title"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100.0dip"
            android:layout_marginTop="40.0dip"
            android:layout_marginRight="100.0dip"
            android:text="" />

        <TextView
            android:textSize="28.0sp"
            android:textColor="@color/color_eeeeee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/appdisable_tv_message"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="160.0dip"
            android:layout_marginTop="40.0dip"
            android:layout_marginRight="160.0dip"
            android:minHeight="200.0dip"
            android:text="@string/appdisable_info" />

        <Button
            android:enabled="true"
            android:textSize="24.0sp"
            android:textColor="@color/color_eeeeee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/appdisable_tv_btn"
            android:background="@drawable/appdisable_btn_selector"
            android:padding="10.0dip"
            android:layout_width="400.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50.0dip"
            android:layout_marginTop="80.0dip"
            android:layout_marginRight="50.0dip"
            android:layout_marginBottom="15.0dip"
            android:text="@string/appdisable_download"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>