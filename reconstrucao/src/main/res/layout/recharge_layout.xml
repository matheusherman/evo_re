<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    android:id="@+id/rechargel_rl_parent"
    android:background="@drawable/icon_transport"
    android:padding="40.0dip"
    android:layout_width="@dimen/recharge_dialog_width_1000"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/recharge_dialog_height_2"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rechargel_ll_user_layout"
        android:background="@drawable/epg_dialog_bg"
        android:layout_width="500.0dip"
        android:layout_height="300.0dip"
        android:layout_centerHorizontal="true">

        <TextView
            android:textSize="@dimen/remind_text_size"
            android:textColor="@color/rechargel_tv_user_id_tc"
            android:gravity="center"
            android:id="@+id/rechargel_tv_user_id"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30.0dip"
            android:text="User ID : 5555555"
            android:layout_alignParentTop="true" />

        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="400.0dip"
            android:layout_height="50.0dip"
            android:layout_marginTop="10.0dip">

            <TextView
                android:id="@+id/rechargel_tv_edit_bg"
                android:background="@drawable/edit_bg"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />

            <EditText
                android:textSize="20.0sp"
                android:textColor="@color/rechargel_et_recharge_tc"
                android:textColorHint="@color/rechargel_et_recharge_tch"
                android:id="@+id/rechargel_et_recharge"
                android:background="@drawable/recharge_edittext_bg"
                android:paddingLeft="10.0dip"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:hint="@string/recharge_code_remind"
                android:singleLine="true"
                android:maxLength="39"
                android:inputType="datetime"
                android:textCursorDrawable="@drawable/edit_color_cursor" />
        </RelativeLayout>

        <com.live.tvcinema.widget.BaseButton
            android:enabled="false"
            android:textSize="20.0sp"
            android:textColor="@color/rechargel_btn_confirm_tc"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/rechargel_btn_confirm"
            android:background="@drawable/dialog_btn_bg_selector"
            android:focusable="false"
            android:layout_width="150.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="40.0dip"
            android:text="@string/confirm" />

        <TextView
            android:textSize="@dimen/remind_text_size"
            android:textColor="@color/rechargel_tv_how_to_recharge_tc"
            android:layout_gravity="center"
            android:id="@+id/rechargel_tv_how_to_recharge"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip" />
    </LinearLayout>

    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/rechargel_ll_remind_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_below="@id/rechargel_ll_user_layout"
        android:layout_centerHorizontal="true">

        <TextView
            android:id="@+id/rechargel_tv_remind1"
            android:visibility="invisible"
            android:text="@string/recharge_code_remind"
            style="@style/ExpiredStyle" />

        <TextView
            android:textSize="18.0sp"
            android:id="@+id/rechargel_tv_remind2"
            android:padding="10.0dip"
            android:visibility="invisible"
            style="@style/ExpiredStyle" />
    </LinearLayout>
</RelativeLayout>