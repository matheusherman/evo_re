<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="center_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <ImageView
            android:id="@+id/countdownl_iv_wallpapers"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="fitXY" />

        <LinearLayout
            android:orientation="vertical"
            android:background="@color/transparent"
            android:layout_width="fill_parent"
            android:layout_height="400.0dip"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <RelativeLayout
                android:id="@+id/countdownl_rl_bg"
                android:background="@color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">

                <TextView
                    android:textSize="22.0sp"
                    android:textColor="@color/color_focused"
                    android:id="@+id/countdownl_tv_time_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80.0dip"
                    android:layout_centerHorizontal="true" />

                <TextView
                    android:textSize="22.0sp"
                    android:textColor="@color/color_eeeeee"
                    android:gravity="center"
                    android:id="@+id/countdownl_tv_remind_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="150.0dip"
                    android:text="@string/tv_start_remind"
                    android:layout_centerHorizontal="true" />

                <TextView
                    android:textSize="20.0sp"
                    android:textColor="@color/color_eeeeee"
                    android:gravity="center"
                    android:id="@+id/countdownl_tv_remind_stop"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="160.0dip"
                    android:text="@string/tv_stop_remind"
                    android:layout_centerHorizontal="true" />

                <View
                    android:id="@+id/countdownl_view_line"
                    android:background="@color/transparent"
                    android:visibility="gone"
                    android:layout_width="500.0dip"
                    android:layout_height="1.0px"
                    android:layout_marginBottom="135.0dip"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true" />

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/countdownl_ll_btn_parent"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="60.0dip"
                    android:layout_alignParentBottom="true">

                    <com.live.tvcinema.widget.BaseButton
                        android:textSize="18.0sp"
                        android:textColor="@color/color_program"
                        android:id="@+id/countdownl_btn_sure"
                        android:background="@drawable/subscribe_btn_bg_selector"
                        android:layout_width="202.0dip"
                        android:layout_height="@dimen/button_exit_height"
                        android:text="@string/play"
                        android:layout_alignParentRight="true"
                        android:textAllCaps="false"
                        style="?android:borderlessButtonStyle" />

                    <com.live.tvcinema.widget.BaseButton
                        android:textSize="18.0sp"
                        android:textColor="@color/color_program"
                        android:layout_gravity="right"
                        android:id="@+id/countdownl_btn_cancel"
                        android:background="@drawable/subscribe_btn_bg_selector"
                        android:layout_width="202.0dip"
                        android:layout_height="@dimen/button_exit_height"
                        android:layout_marginLeft="20.0dip"
                        android:text="@string/exit"
                        android:layout_alignParentLeft="true"
                        android:textAllCaps="false"
                        style="?android:borderlessButtonStyle" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>