<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    android:id="@+id/rechargeremindf_rl_parent"
    android:background="@drawable/login_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:textSize="20.0sp"
        android:textColor="@color/rechargeremindf_tv_remind_tc"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rechargeremindf_tv_remind"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginRight="50.0dip"
        android:maxLines="4"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="3.0dip" />

    <TextView
        android:textSize="20.0sp"
        android:textColor="@color/rechargeremindf_tv_remind_tc"
        android:gravity="center"
        android:id="@+id/rechargeremindf_tv_userid"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dip"
        android:text="User Id:"
        android:layout_below="@id/rechargeremindf_tv_remind" />

    <include
        android:id="@+id/rechargeremindf_ll_recharge"
        android:layout_width="800.0dip"
        android:layout_height="350.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_below="@id/rechargeremindf_tv_userid"
        android:layout_centerHorizontal="true"
        layout="@layout/remind_recharge_layout_b" />

    <View
        android:id="@+id/rechargeremindf_ll_line"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_below="@id/rechargeremindf_tv_userid" />

    <TextView
        android:id="@+id/rechargeremindf_tv_later"
        android:background="@drawable/load_btn_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="15.0dip"
        android:minWidth="200.0dip"
        android:minHeight="40.0dip"
        android:text="@string/skip"
        android:layout_below="@id/rechargeremindf_ll_recharge"
        android:layout_centerHorizontal="true"
        style="@style/ButtonStyle" />

    <TextView
        android:id="@+id/rechargeremindf_tv_bind"
        android:background="@drawable/load_btn_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="200.0dip"
        android:minHeight="40.0dip"
        android:text="@string/bind_email"
        android:layout_below="@id/rechargeremindf_tv_later"
        android:layout_centerHorizontal="true"
        style="@style/ButtonStyle" />

    <TextView
        android:textSize="18.0sp"
        android:textColor="@color/rechargeremindf_tv_how_to_recharge_tc"
        android:id="@+id/rechargeremindf_tv_how_to_recharge"
        android:background="@drawable/load_register_selector"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_below="@id/rechargeremindf_tv_bind"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/renewuser_ll_refresh_layout"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="35.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_below="@id/rechargeremindf_tv_how_to_recharge"
        android:layout_centerHorizontal="true">

        <TextView
            android:textSize="18.0sp"
            android:textColor="@color/rechargeremindf_tv_how_to_recharge_tc"
            android:id="@+id/renewuser_tv_refresh_remind"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/refresh_user"
            android:singleLine="true" />

        <LinearLayout
            android:gravity="center"
            android:id="@+id/renewuser_ll_refresh"
            android:background="@drawable/bg_circle_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="35.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="10.0dip">

            <ImageView
                android:id="@+id/renew_qrcode_refresh"
                android:duplicateParentState="true"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/refresh_selector"
                android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:textSize="18.0sp"
        android:textColor="@color/rechargeremindf_tv_remind_bottom_tc"
        android:id="@+id/rechargeremindf_tv_remind_bottom"
        android:paddingLeft="20.0dip"
        android:paddingRight="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="100.0dip"
        android:layout_marginRight="250.0dip"
        android:layout_marginBottom="20.0dip"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="3.0dip" />

    <com.live.tvcinema.widget.LightTextView
        android:textSize="20.0sp"
        android:textColor="@color/rechargeremindf_ltv_remind_hint_tc"
        android:id="@+id/rechargeremindf_ltv_remind_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="120.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_marginRight="100.0dip"
        android:text="@string/how_to_buy_play"
        android:layout_above="@id/rechargeremindf_tv_remind_bottom"
        android:lineSpacingExtra="3.0dip" />
</RelativeLayout>