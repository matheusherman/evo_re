<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@drawable/menu_child_bg"
    android:layout_width="@dimen/setting_bg_width"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lly_left"
        android:layout_width="@dimen/search_bg_width"
        android:layout_height="fill_parent">

        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/epg_text_color"
            android:gravity="center"
            android:id="@+id/tv_settings_dsc"
            android:visibility="gone"
            android:layout_width="260.0dip"
            android:layout_height="80.0dip"
            android:layout_marginTop="20.0dip"
            android:text=""
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true" />

        <com.live.tvcinema.widget.ProgramListView
            android:id="@+id/lv_settings"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="30.0dip"
            android:layout_marginBottom="45.0dip"
            android:listSelector="@drawable/bg_program"
            android:divider="@null" />

        <TextView
            android:textSize="25.0sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_no_data"
            android:background="@drawable/bg_program"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_data"
            android:layout_centerInParent="true" />
    </LinearLayout>

    <TextView
        android:textSize="18.0sp"
        android:textColor="@color/contactf_tv_info_mac_tc"
        android:gravity="center|left|top"
        android:id="@+id/setting_tv_info_mac"
        android:paddingLeft="12.0dip"
        android:paddingRight="12.0dip"
        android:paddingBottom="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="MAC: ec2c98110098"
        android:layout_alignParentBottom="true" />
</RelativeLayout>