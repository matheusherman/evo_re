<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:textSize="@dimen/sm_14"
        android:textColor="@color/loginf_tv_renewal_tip_tc"
        android:gravity="center"
        android:id="@+id/loginf_tv_qr_tip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50.0dip"
        android:layout_marginTop="50.0dip"
        android:layout_marginRight="50.0dip"
        android:maxHeight="50.0dip"
        android:text="@string/qr_login_tip_top" />

    <ImageView
        android:id="@+id/loginf_iv_qr"
        android:background="@drawable/qr_placehodler"
        android:layout_width="300.0dip"
        android:layout_height="300.0dip"
        android:layout_marginTop="25.0dip"
        android:layout_below="@id/loginf_tv_qr_tip"
        android:layout_centerHorizontal="true" />

    <View
        android:background="@color/scanqr_divider_color"
        android:layout_width="2.0dip"
        android:layout_height="fill_parent"
        android:layout_marginTop="30.0dip"
        android:layout_marginBottom="20.0dip"
        android:layout_alignParentRight="true" />
</RelativeLayout>