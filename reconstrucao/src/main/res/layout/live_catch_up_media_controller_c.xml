        <TextView android:ellipsize="marquee" android:id="@id/mediacontroller_file_name" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_marginStart="5.0dp" style="@style/PureMediaController_Text" />
