<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/subscribe_focus_bg_solid" />
            <size android:height="@dimen/sm_49" android:width="@dimen/sm_49" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape android:shape="oval">
            <solid android:color="@color/gray_focus_bg_solid" />
            <size android:height="@dimen/sm_49" android:width="@dimen/sm_49" />
        </shape>
    </item>
</selector>
