<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/progressbar_play_background" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="@color/progressbar_play_secondaryprogress_start" android:endColor="@color/progressbar_play_secondaryprogress_end" android:angle="270.0" android:centerY="0.75" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/progressbar_play_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
