<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/catch_up_mc_progress_background" />
            <corners android:radius="@dimen/sm_2" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="@dimen/sm_2" />
                <solid android:color="@color/catch_up_mc_progress_secondaryprogress" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/sm_2" />
                <solid android:color="@color/catch_up_mc_progress_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
