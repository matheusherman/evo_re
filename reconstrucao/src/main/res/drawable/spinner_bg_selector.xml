<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ctrl_radius" />
            <solid android:color="@color/focus_login_solid" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ctrl_radius" />
            <solid android:color="@color/focus_login_solid" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_selected="false" android:drawable="@drawable/back_line_unfocus" />
</selector>
