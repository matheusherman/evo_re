<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/half_blue" />
            <corners android:radius="1000.0dp" />
            <stroke android:width="2.0dp" android:color="@color/red" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/half_white" />
            <corners android:radius="1000.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/half_gray" />
            <corners android:radius="1000.0dp" />
        </shape>
    </item>
</selector>
